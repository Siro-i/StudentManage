<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.school.system.mapper.UserMapper">

    <resultMap id="BaseResultMap" type="com.school.system.entity.User">
        <id column="user_id" property="userId" />
        <result column="user_name" property="userName" />
        <result column="user_pwd" property="userPwd" />
        <result column="user_real_name" property="userRealName" />
        <result column="user_type" property="userType" />
        <result column="user_createtime" property="userCreatetime" />
        <result column="user_updatetime" property="userUpdatetime" />
    </resultMap>

    <select id="findByUsername" resultMap="BaseResultMap">
        SELECT * FROM user_table WHERE user_name = #{username}
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM user_table WHERE user_id = #{userId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="userId">
        INSERT INTO user_table (
            user_name,
            user_real_name,
            user_pwd,
            user_type,
            user_phone,   user_email,   user_createtime,
            user_updatetime
        ) VALUES (
                     #{userName},
                     #{userRealName},
                     #{userPwd},
                     #{userType},
                     #{userPhone}, #{userEmail}, #{userCreatetime},
                     #{userUpdatetime}
                 )
    </insert>

    <update id="updateById">
        UPDATE user_table
        <set>
            <if test="userName != null and userName != ''">user_name = #{userName},</if>
            <if test="userRealName != null and userRealName != ''">user_real_name = #{userRealName},</if>
            <if test="userPwd != null and userPwd != ''">user_pwd = #{userPwd},</if>
            <if test="userType != null and userType != ''">user_type = #{userType},</if>

            <if test="userPhone != null">user_phone = #{userPhone},</if>
            <if test="userEmail != null">user_email = #{userEmail},</if>

            <if test="userUpdatetime != null">user_updatetime = #{userUpdatetime},</if>
        </set>
        WHERE user_id = #{userId}
    </update>
    <select id="selectList" resultType="com.school.system.entity.User">
        SELECT
        u.*,
        s.student_college,
        s.student_class,
        s.student_grade,
        t.teacher_college,
        t.teacher_title

        FROM user_table u
        LEFT JOIN student_table s ON u.user_id = s.user_id
        LEFT JOIN teacher_table t ON u.user_id = t.user_id

        <where>
            <if test="userType != null and userType != ''">
                AND u.user_type = #{userType}
            </if>

            <if test="userRealName != null and userRealName != ''">
                AND u.user_real_name LIKE concat('%', #{userRealName}, '%')
            </if>

            <if test="userPhone != null and userPhone != ''">
                AND u.user_phone LIKE concat('%', #{userPhone}, '%')
            </if>
        </where>

        ORDER BY u.user_createtime DESC
    </select>
    <delete id="deleteById">
        DELETE FROM user_table WHERE user_id = #{userId}
    </delete>
</mapper>